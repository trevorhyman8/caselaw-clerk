# Copy to .env for local dev. In Railway, set these as service Variables —
# never commit a real .env. See SETUP.md for where each value comes from.

DATABASE_URL=sqlite:///.private/caselaw.db
PIPELINE_MODE=shadow
PUBLISHING_MODE=draft_only

COURTLISTENER_TOKEN=
CL_WEBHOOK_SECRET=
GOVINFO_API_KEY=

# claude_p = local dev, $0, needs `claude` CLI logged in. anthropic_api =
# required for the deployed Railway service (see pipeline/llm.py docstring).
LLM_BACKEND=claude_p
ANTHROPIC_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

WPCOM_CLIENT_ID=
WPCOM_CLIENT_SECRET=
WPCOM_ACCESS_TOKEN=
WPCOM_SITE_ID=
